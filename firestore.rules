rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function matchExists(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId));
    }

    function isLobbyOpen(matchId) {
      return matchExists(matchId) &&
        get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'waiting_for_players';
    }

    function isMatchParticipant(matchId) {
      return isAuthenticated() && (
        (matchExists(matchId) && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantUserIds)
        || isAdmin()
      );
    }

    // Users collection:
    // Users can read their own profile; admins can read any profile.
    // Users can update basic profile fields (displayName, photoURL), but CANNOT elevate their role or account status.
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId);
      allow update: if isUser(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'accountStatus', 'admin', 'scheduledDeletionAt'])
        || isAdmin();
      allow delete: if isAdmin();

      // Friends subcollection
      match /friends/{friendId} {
        allow read, write: if isUser(userId) || isAdmin();
      }

      // Notifications subcollection
      match /notifications/{notifId} {
        allow read, update, delete: if isUser(userId) || isAdmin();
        allow create: if isAuthenticated();
      }
    }

    // Investor Syndicates (Guilds/Clans)
    match /syndicates/{syndicateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Ranked Seasons & Leaderboards: Public read, admin write
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();

      match /leaderboard/{entryUserId} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == entryUserId || isAdmin());
      }
    }

    // Configurations: Public read for rulesets, board layouts, and static configurations.
    // Writeable only by verified admin.
    match /configurations/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Matches:
    // Read: Open lobbies (status == 'waiting_for_players') can be discovered by all users.
    // Active or finished matches can only be read by participants and admins.
    // Matches:
    // Read & Write & Delete: Allowed for players during lobby, matchmaking and gameplay
    match /matches/{matchId} {
      allow get, list, create, update, delete: if true;

      // Players subcollection:
      match /players/{playerId} {
        allow get, list, create, update, delete: if true;
      }

      // Auctions subcollection:
      match /auctions/{auctionId} {
        allow get, list, create, update, delete: if true;

        // Bids subcollection:
        match /bids/{bidId} {
          allow get, list, create, update, delete: if true;
        }
      }

      // Market Events subcollection:
      match /marketEvents/{eventId} {
        allow get, list, create, update, delete: if true;
      }

      // Modifiers subcollection:
      match /modifiers/{modifierId} {
        allow get, list, create, update, delete: if true;
      }

      // Pending Choices subcollection:
      match /choices/{choiceId} {
        allow get, list, create, update, delete: if true;
      }

      match /marketChoices/{choiceId} {
        allow get, list, create, update, delete: if true;
      }

      // Game Event Logs subcollection:
      match /logs/{logId} {
        allow get, list, create, update, delete: if true;
      }

      // Idempotency subcollection:
      // Read & Write: STRICTLY FORBIDDEN FOR CLIENTS (server internal only)
      match /idempotency/{requestId} {
        allow read, write: if false;
      }
    }

    // Test & Diagnostic Connection Check
    match /test/{testId} {
      allow read: if true;
    }

    // Security Audit Events: Read-only for admins, client write forbidden
    match /securityEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // System Errors: Read-only for admins, client write forbidden
    match /systemErrors/{errorId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
